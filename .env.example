VITE_APP_NAME=Inventory Scan

# Optional override (gitignored). See README for mode defaults.
#   .env.local                → mọi mode (dev + build)
#   .env.development.local    → chỉ npm run dev
# VITE_API_URL=http://10.0.111.127:7094

# Force UI shell at build time: web | mobile
# VITE_APP_SHELL=web

# Production website origin — native app opens these in the system browser
# VITE_PUBLIC_WEB_ORIGIN=https://inventory.example.com
